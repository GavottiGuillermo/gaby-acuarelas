PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000

# Mercado Pago
MERCADOPAGO_ENV=sandbox
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# PayPal (usar sandbox durante el desarrollo)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Correo transaccional
RESEND_API_KEY=
EMAIL_FROM=Gaby Acuarelas <cursos@tu-dominio.com>

# Entrega desde Dropbox: nunca publicar estos datos en el frontend
DROPBOX_ACCESS_TOKEN=
DROPBOX_COURSES_ROOT=/Cursos

# Base de datos. Usar la URL interna dentro de Render y la externa para desarrollo local.
# DATABASE_URL corresponde al usuario limitado de la aplicación.
DATABASE_URL=
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=5000
# Para la URL externa de Render usar require; para la interna, dejar vacío.
DATABASE_SSL_MODE=
DATABASE_APP_PASSWORD=

# Usar solamente para migraciones y no configurar en el servicio web.
DATABASE_MIGRATION_URL=
